<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>Courrier</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; padding: 0; }
      body { margin: 0; padding: 0; font-size: 16px; line-height: 1.5; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"; background-color: rgb(241 245 249); }
      .layout { display: flex; column-gap: 1rem; }
      .sidebar {
        display: flex; flex-direction: column; position: sticky; top: 0;
        padding: .5rem; width: min(350px, 33.3333%); height: 100dvh;
        border-right: 1px solid rgb(226 232 240);
      }
      .sidebar__options {
        position: sticky; bottom: 0; padding: .5rem;
        background-color: rgb(241 245 249);
      }
      .sidebar__btn-clear {
        border: none; display: flex; align-items: center; justify-content: center;
        column-gap: .25rem; width: 100%; padding: .5rem;
        font-size: .875rem; line-height: 1.25rem; font-weight: 500;
        color: rgb(71 85 105); background-color: rgb(226 232 240);
        border-radius: .5rem; cursor: default;
        &:hover { background-color: rgb(203 213 225); }
        &:active { transform: scale(.98); }
        [data-slot="icon"] { width: .875rem; height: .875rem; }
      }
      .email-list {
        display: flex; flex-direction: column; flex: 1; row-gap: .5rem;
        overflow-y: auto; width: 100%;
      }
      .email-list__item {
        padding: .5rem .75rem; border-radius: .5rem;
        &:hover { background-color: rgb(226 232 240 / .75); }
      }
      .email-list--empty { display: none; text-align: center; &:only-child { display: block; } }
      .email-list__primary {
        display: inline-block; font-size: 1rem; line-height: 1.5rem; font-weight: 600;
        letter-spacing: -.025em; color: rgb(51 65 85); text-decoration: none;
        &:hover { color: rgb(59 130 246); }
      }
      .email-list__secondary {
        margin-top: .125rem;
        overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1;
        color: rgb(100 116 139);
      }
      .email-list__scenarios {
        display: flex; flex-wrap: wrap; gap: .25rem; margin-top: .25rem;
      }
      .email-list__scenario {
        font-size: .75rem; padding: .125rem .5rem;
        background-color: rgb(226 232 240); border-radius: 9999px;
        color: rgb(71 85 105); text-decoration: none;
        &:hover { background-color: rgb(203 213 225); }
      }
      .scenario--active { background-color: rgb(59 130 246); color: white; &:hover { background-color: rgb(37 99 235); } }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <ul class="email-list">
          <% if @emails.empty? %>
            <li class="email-list--empty">
              <p class="email-list__secondary">No emails yet...</p>
            </li>
          <% end %>
          <% @emails.each do |email| %>
            <li class="email-list__item">
              <%= link_to email.primary, email.link, data: {remote: true}, class: "email-list__primary" %>
              <% if email.secondary %>
                <div class="email-list__secondary"><%= email.secondary %></div>
              <% end %>
              <% if email.scenarios %>
                <div class="email-list__scenarios">
                  <% email.scenarios.each do |scenario| %>
                    <%= link_to scenario[:name], scenario[:link], data: {remote: true}, class: "email-list__scenario" %>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if @show_clear %>
          <div class="sidebar__options">
            <%= button_to courrier.cleanup_path, class: "sidebar__btn-clear" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-slot="icon">
                <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"/>
              </svg>
              Clear inbox
            <% end %>
          </div>
        <% end %>
      </aside>
      <article style="flex: 1;" id="email-preview">
      </article>
    </div>
    <script>
      document.querySelectorAll("a[data-remote]").forEach(link => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          fetch(link.href).then(r => r.text()).then(html => {
            document.getElementById("email-preview").innerHTML = html;
          });
        });
      });
    </script>
  </body>
</html>
